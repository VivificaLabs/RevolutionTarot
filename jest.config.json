{
  "testEnvironment": "node",
  "roots": ["<rootDir>"],
  "testMatch": [
    "**/__tests__/**/*.test.ts",
    "**/__tests__/**/*.test.tsx"
  ],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/$1"
  },
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", { "tsconfig": { "jsx": "react-jsx" } }]
  },
  "collectCoverageFrom": [
    "lib/**/*.ts",
    "!lib/**/*.test.ts",
    "!lib/__tests__/**"
  ],
  "coveragePathIgnorePatterns": [
    "/node_modules/",
    "/.next/"
  ],
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/.next/"
  ]
}
